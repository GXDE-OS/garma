# Maintainer: CharOfString <root@charofstring.cc>
pkgname=garma-git
pkgver=2.0.0
pkgrel=1
pkgdesc='Zenity-compatible dialog tool for GXDE, based on Qt6 and DTK2 (Qt6 port)'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/garma"
license=('GPL-2.0-only')
depends=('dtk2widget-qt6-git' 'gxde-qt6integration-git' 'qt6-base' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
provides=('garma')
conflicts=('garma')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
